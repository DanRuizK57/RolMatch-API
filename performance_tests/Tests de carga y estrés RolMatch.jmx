            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET Obtener usuario por ID" enabled="true">
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
